# ================================================================
# MinimumViablePerseus — Sharded-freeze builder image
#
# Unlike Dockerfile (which clones all corpora into one image for a single
# unsharded build), this also clones every corpus into one CORPORA_DIR --
# same as Dockerfile, and same as a full local checkout -- but its
# entrypoint runs `mvp-build --mode corpus-only --shard-index/--shard-count`,
# writing only a slice of the full site's pages to disk. Used by
# .github/workflows/build-corpus.yml — each matrix leg builds and runs its
# own instance of this image with a different --shard-index, so the
# (expensive) freeze step still runs in parallel across N runners even
# though every runner needs the same complete CORPORA_DIR to resolve
# cross-corpus sibling/commentary links correctly (see mvp.site.siblings —
# a commentary's "related works" panel is looked up against whatever work
# it's about, which often lives in a different corpus repo than the
# commentary itself). The image itself is never pushed to GHCR; only the
# frozen pages + manifest.json it writes to /app/build are shipped onward
# (see that workflow).
# ================================================================

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# ----------------------------------------------------------------
# Every corpus's TEI data -- all of it, in every shard's image, so any
# shard can resolve a sibling/commentary link into any other corpus the
# same way a full local checkout's combined CORPORA_DIR does. Each clone
# gets its own SHA build-arg (not read directly -- see the `echo` in each
# RUN below) purely so that corpus's HEAD SHA becomes part of that layer's
# cache key: only the corpus that actually changed gets re-cloned, the
# other four stay cached, same technique the old single-corpus clone used.
# ----------------------------------------------------------------
ARG CORPORA_DIR=/corpora
ARG GREEKLIT_SHA=latest
ARG LATINLIT_SHA=latest
ARG FIRST1KGREEK_SHA=latest
ARG NDDLC_SHA=latest
ARG GRCNEWXML_SHA=latest

RUN echo "greekLit @ ${GREEKLIT_SHA}" && \
    git clone --depth 1 --branch master \
    https://github.com/PerseusDL/canonical-greekLit "${CORPORA_DIR}/greekLit"

RUN echo "latinLit @ ${LATINLIT_SHA}" && \
    git clone --depth 1 --branch master \
    https://github.com/PerseusDL/canonical-latinLit "${CORPORA_DIR}/latinLit"

RUN echo "First1KGreek @ ${FIRST1KGREEK_SHA}" && \
    git clone --depth 1 --branch editing \
    https://github.com/PerseusDLCode/First1KGreek "${CORPORA_DIR}/First1KGreek"

RUN echo "Notre-Dame-Digitized-Latin-Collection @ ${NDDLC_SHA}" && \
    git clone --depth 1 --branch main \
    https://github.com/PerseusDLCode/Notre-Dame-Digitized-Latin-Collection \
    "${CORPORA_DIR}/Notre-Dame-Digitized-Latin-Collection"

RUN echo "grcnewxml @ ${GRCNEWXML_SHA}" && \
    git clone --depth 1 --branch main \
    https://github.com/gregorycrane/grcnewxml.git "${CORPORA_DIR}/grcnewxml"

# canonical-pdlrefwk (public repo, commentary-linking data every shard
# needs) is copied from the build context instead of git-cloned here: the
# workflow fetches it once (see fetch-pdlrefwk job in build-corpus.yml) and
# shares that single checkout across every matrix leg, rather than each
# leg re-cloning it independently. A COPY's cache key is the copied
# content's own checksum, so no SHA build-arg is needed to invalidate it
# the way the git clones above need one.
COPY canonical-pdlrefwk/ "${CORPORA_DIR}/canonical-pdlrefwk/"

# Token sidecars (.tokens.json.zst) are generated by mvp-tokenization's
# mvp-pipeline (fast tokenize-only pass over perseus-cts-compiled citation
# chunks) and pulled as OCI artifacts (one per corpus) into tokenized-pages/
# in the build context (see .github/workflows/build-corpus.yml's "Fetch
# tokens artifacts" step, which extracts all of them into the same
# directory -- each corpus's archive already nests under its own corpus
# segment, mirroring PROTO_DIR's layout, so they merge rather than
# collide) before this Dockerfile runs. Baked into the image via COPY
# rather than bind-mounted at `docker run` time, matching
# canonical-pdlrefwk's COPY above. May be empty or partial if a given
# corpus hasn't been through the tokenize-corpus workflow yet -- the
# reading view renders fine without token sidecars.
COPY tokenized-pages/ /app/tokens/

WORKDIR /app

COPY pyproject.toml .
COPY README.md .
COPY uv.lock .

ENV UV_PYTHON=3.12
RUN uv sync --no-dev --no-install-project --no-cache

COPY src/ src/
RUN uv sync --no-dev --no-cache

ENV CORPORA_DIR=${CORPORA_DIR}
ENV PROTOPAGE_OUTPUT_DIR=/app/proto-pages

# Matches the COPY above. MVP_TOKENS_DIR only needs to be set when a
# sidecar tree actually exists there; the reading view renders fine
# without it.
ENV MVP_TOKENS_DIR=/app/tokens

# New Alexandria Commentaries (see src/tools/fetch_new_alexandria.py) are
# fetched once per workflow run and bind-mounted here at `docker run` time
# (see build-corpus.yml), same reasoning as MVP_TOKENS_DIR above — never
# baked into the image, and optional at render time.
ENV NEW_ALEXANDRIA_DIR=/app/new-alexandria

# ENTRYPOINT (rather than CMD) so `docker run <image> --source-digest sha256:... --shard-index N --shard-count M`
# appends to `--mode corpus-only`, instead of replacing it outright.
# MORPH_URL must still be passed via `-e` at runtime, same as Dockerfile.
ENTRYPOINT ["uv", "run", "mvp-build", "--mode", "corpus-only"]
